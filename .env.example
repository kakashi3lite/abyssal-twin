# IoRT-DT Environment Configuration
# Copy to .env and edit values before running docker compose.

# ─── Fleet ──────────────────────────────────────────────────────────────────
# Number of AUVs in simulation (1-8)
IORT_DT_AUV_COUNT=2

# ─── Federation ─────────────────────────────────────────────────────────────
# Gossip interval in milliseconds (lower = faster convergence, more bandwidth)
GOSSIP_INTERVAL_MS=500
# Seconds before a peer is considered partitioned
PARTITION_TIMEOUT_S=30

# ─── ROS 2 ──────────────────────────────────────────────────────────────────
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_zenoh_cpp

# ─── Observability ──────────────────────────────────────────────────────────
# Grafana admin password (change in production)
GRAFANA_ADMIN_PASSWORD=admin

# ─── Logging ────────────────────────────────────────────────────────────────
# Rust log level: trace, debug, info, warn, error
RUST_LOG=iort_dt_federation=info

# ─── Acoustic Security (C5, Phase 6) ────────────────────────────────────────
# Per-message HMAC key for the acoustic link (57-byte authenticated frames).
# MUST match the Python fleet tier's signing key (security.py). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value — set it in the vessel's environment.
ACOUSTIC_HMAC_KEY=

# Zenoh TLS transport (optional). Generate certs with:
#   bash scripts/ci/generate_zenoh_tls.sh
# Then set absolute paths (or leave empty for plaintext simulation).
ZENOH_TLS_ROOT_CA=configs/security/zenoh/ca_cert.pem
ZENOH_TLS_LISTEN_KEY=configs/security/zenoh/router_key.pem
ZENOH_TLS_LISTEN_CERT=configs/security/zenoh/router_cert.pem
ZENOH_TLS_CONNECT_KEY=configs/security/zenoh/gateway_key.pem
ZENOH_TLS_CONNECT_CERT=configs/security/zenoh/gateway_cert.pem
